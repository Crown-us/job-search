# LLM scoring + cover letters (optional)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Email digest (optional). For Gmail, create an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=

# Windows notification (optional). Only needed for the native toast engine:
# register this AppID once, then put the same string here.
#   $p = 'HKCU:\SOFTWARE\Classes\AppUserModelId\JobHunter.Toast'
#   New-Item -Path $p -Force
#   Set-ItemProperty -Path $p -Name DisplayName -Value 'Job Hunter'
#   Set-ItemProperty -Path $p -Name ShowInSettings -Value 1 -Type DWord
TOAST_APP_ID=

# Discord webhook (optional). Server Settings -> Integrations -> Webhooks -> New
# Webhook -> Copy Webhook URL. Treat it as a password: anyone holding it can post.
DISCORD_WEBHOOK_URL=
